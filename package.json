{
  "name": "tronpay-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "prepare-website": "node website/assemble-src.mjs",
